PORT=8080
BASE_URL=https://media.stayfix.co

# Firebase admin — service account file is placed at /opt/stayfix-media/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Email invite webhook token (keep this secret — used by Flutter app)
INVITE_WEBHOOK_TOKEN=TZQGnYOLKf77EctUtmosH73ursXR7jbPeTpH42KCnabXGV3KuPr0XSR8rdqXo

# SMTP — fill in when you have the mailbox password
SMTP_HOST=mail.stayfix.co
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=_mainaccount@stayfix.co
SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM=Stayfix <_mainaccount@stayfix.co>

# File size limits
MAX_IMAGE_MB=15
MAX_AUDIO_MB=20
